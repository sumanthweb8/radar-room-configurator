# Databricks SQL Warehouse connection for the Movement viewer's "Load latest".
# Copy this file to `.env` (same folder) and fill in real values.
# `.env` is git-ignored — never commit your token.

# Workspace hostname — SQL Warehouses → your warehouse → Connection details → Server hostname
DATABRICKS_SERVER_HOSTNAME=dbc-xxxxxxxx-xxxx.cloud.databricks.com

# HTTP path — same Connection details tab. For warehouse kc-inhouse-server this is:
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/a3f419415962f83b

# Personal access token — profile icon → Settings → Developer → Access tokens → Generate
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXX
